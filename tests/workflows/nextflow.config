// For the tests in this folder, which run every task in Docker on the local machine.
docker.enabled = true

process {
    // A CI runner or a laptop's Docker VM may have fewer CPUs than a process asks for.
    resourceLimits = [cpus: 2, memory: 4.GB]
    // The family tables' steps, and the processes that make and check their files, in the tools image built before the
    // test (family_tables.nf), so that the bcftools steps run the bcftools a deployment runs.
    withName: 'FAMILY_CHECK.*|NORMALISE_.*|UNION_SITES|SV_SITES.*|SV_UNION.*|ECHTVAR_VALUES.*|JOINED_VALUES.*|CHECK_JOINED.*|TRANSCRIPT_RULES.*|ANNOTATION_TABLES|SV_ANNOTATION_TABLES|ROH_UPD.*|FAMILY_TABLES|INVENTED_.*|COMPRESSED|DERIVED|CHECK_TABLES|CHECK_GNOMAD_ALONE|CHECK_NO_ROLES|CHECK_REF_N|CHECK_LARGER|CHECK_SV_UNION|CHECK_SEGMENTS|CHECK_ROH_UPD|CHECK_NOT_ASSESSED|CHECK_TRANSCRIPT_RULES' {
        container = 'case-annotation-tools-test'
    }
    // Some cases are refused on purpose; the workflow checks which ones came through.
    withName: '.*_REFUSED' {
        errorStrategy = 'ignore'
    }
    // An invented upd in place of the image's, which writes a region and fails (family_tables/failing-upd).
    withName: ROH_UPD_FAILING_UPD_REFUSED {
        containerOptions = "-v ${projectDir}/family_tables/failing-upd:/opt/venv/bin/upd:ro"
    }
    // The Annotator's processes run in a stand-in for the Annotator's image, a base with jq (annotator/Dockerfile, built
    // before the test), with the invented Annotator and the invented gcp-secret mounted (annotator.nf).
    withLabel: illumina {
        container = 'annotator-test'
        containerOptions = "-v ${projectDir}/annotator:/invented:ro -v ${projectDir}/annotator/gcp-secret:/usr/local/bin/gcp-secret:ro"
    }
}
