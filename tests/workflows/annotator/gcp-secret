#!/usr/bin/env bash
# An invented stand-in for the gcp-secret of the Annotator's image: prints an invented key for a secret version, and one
# too short to redact for a secret named short.
set -euo pipefail
if [[ $1 == */secrets/short/* ]]; then
    echo 'short'
else
    echo 'invented-key-0123456789abcdef'
fi
