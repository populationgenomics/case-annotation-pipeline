{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AnnotationInfo": {
      "description": "What annotated the union.\n\nThe Annotator, the catalog, the sources the run named and the versions they pinned, the data sources the JSON\nheader records, and the bundle's sources the run left out.",
      "properties": {
        "annotator": {
          "title": "Annotator",
          "type": "string"
        },
        "json_schema_version": {
          "title": "Json Schema Version",
          "type": "integer"
        },
        "assembly": {
          "title": "Assembly",
          "type": "string"
        },
        "catalog": {
          "title": "Catalog",
          "type": "string"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "source_versions": {
          "items": {
            "$ref": "#/$defs/SourceVersion"
          },
          "title": "Source Versions",
          "type": "array"
        },
        "data_sources": {
          "items": {
            "$ref": "#/$defs/DataSource"
          },
          "title": "Data Sources",
          "type": "array"
        },
        "omitted": {
          "items": {
            "$ref": "#/$defs/OmittedSource"
          },
          "title": "Omitted",
          "type": "array"
        }
      },
      "required": [
        "annotator",
        "json_schema_version",
        "assembly",
        "catalog",
        "sources",
        "source_versions",
        "data_sources",
        "omitted"
      ],
      "title": "AnnotationInfo",
      "type": "object"
    },
    "ArchiveField": {
      "description": "One field of an echtvar archive, as the configuration embedded in the archive records it.",
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "alias": {
          "title": "Alias",
          "type": "string"
        },
        "ftype": {
          "enum": [
            "Integer",
            "Float",
            "Categorical",
            "Flag"
          ],
          "title": "Ftype",
          "type": "string"
        },
        "multiplier": {
          "title": "Multiplier",
          "type": "integer"
        },
        "missing_value": {
          "title": "Missing Value",
          "type": "integer"
        },
        "missing_string": {
          "title": "Missing String",
          "type": "string"
        }
      },
      "required": [
        "field",
        "alias",
        "ftype",
        "multiplier",
        "missing_value",
        "missing_string"
      ],
      "title": "ArchiveField",
      "type": "object"
    },
    "ArchiveInfo": {
      "description": "An echtvar archive that a run read values from, and the echtvar that read it.",
      "properties": {
        "archive": {
          "title": "Archive",
          "type": "string"
        },
        "bytes": {
          "title": "Bytes",
          "type": "integer"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "echtvar_version": {
          "minLength": 1,
          "title": "Echtvar Version",
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/ArchiveField"
          },
          "title": "Fields",
          "type": "array"
        }
      },
      "required": [
        "archive",
        "bytes",
        "sha256",
        "echtvar_version",
        "fields"
      ],
      "title": "ArchiveInfo",
      "type": "object"
    },
    "Caller": {
      "enum": [
        "sv",
        "cnv"
      ],
      "type": "string"
    },
    "DataSource": {
      "description": "One data source as the JSON header records it.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "release_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Release Date"
        }
      },
      "required": [
        "name",
        "version",
        "release_date"
      ],
      "title": "DataSource",
      "type": "object"
    },
    "FamilyMember": {
      "properties": {
        "sample_id": {
          "title": "Sample Id",
          "type": "string"
        },
        "father": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Father"
        },
        "mother": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mother"
        },
        "sex": {
          "$ref": "#/$defs/Sex"
        },
        "affected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Affected"
        },
        "sequenced": {
          "title": "Sequenced",
          "type": "boolean"
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/Role"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "sample_id",
        "father",
        "mother",
        "sex",
        "affected",
        "sequenced",
        "role"
      ],
      "title": "FamilyMember",
      "type": "object"
    },
    "FileRecord": {
      "description": "A file as a run read it.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "bytes": {
          "title": "Bytes",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "name",
        "bytes",
        "sha256"
      ],
      "title": "FileRecord",
      "type": "object"
    },
    "FrequencyArchive": {
      "description": "The echtvar archive that gave each site its frequency, and the echtvar that read it.",
      "properties": {
        "archive": {
          "title": "Archive",
          "type": "string"
        },
        "bytes": {
          "title": "Bytes",
          "type": "integer"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "echtvar_version": {
          "minLength": 1,
          "title": "Echtvar Version",
          "type": "string"
        },
        "field": {
          "$ref": "#/$defs/ArchiveField"
        }
      },
      "required": [
        "archive",
        "bytes",
        "sha256",
        "echtvar_version",
        "field"
      ],
      "title": "FrequencyArchive",
      "type": "object"
    },
    "GeneModelAnnotated": {
      "description": "One gene model file of a run: the file as the run read it, and the public file that it was prepared from.",
      "properties": {
        "source": {
          "$ref": "#/$defs/Source"
        },
        "file": {
          "$ref": "#/$defs/FileRecord"
        },
        "prepared_from": {
          "$ref": "#/$defs/PublicFile"
        }
      },
      "required": [
        "source",
        "file",
        "prepared_from"
      ],
      "title": "GeneModelAnnotated",
      "type": "object"
    },
    "JoinedFile": {
      "description": "A file that a run joined to the union's alleles, as the run read it.",
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "bytes": {
          "title": "Bytes",
          "type": "integer"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "source",
        "file",
        "bytes",
        "sha256"
      ],
      "title": "JoinedFile",
      "type": "object"
    },
    "NotAssessed": {
      "description": "A child whose parents are both sequenced and that upd was not run for, with the reason.",
      "properties": {
        "child": {
          "title": "Child",
          "type": "string"
        },
        "mother": {
          "title": "Mother",
          "type": "string"
        },
        "father": {
          "title": "Father",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/Reason"
        }
      },
      "required": [
        "child",
        "mother",
        "father",
        "reason"
      ],
      "title": "NotAssessed",
      "type": "object"
    },
    "NotesFile": {
      "description": "The notes on the tables in a family's folder, named as a table's file is (TableFile).",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "bytes": {
          "title": "Bytes",
          "type": "integer"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "title": "NotesFile",
      "type": "object"
    },
    "NoticedArchiveInfo": {
      "description": "An archive whose values are under terms that ask for a notice with every copy of them.",
      "properties": {
        "archive": {
          "title": "Archive",
          "type": "string"
        },
        "bytes": {
          "title": "Bytes",
          "type": "integer"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "echtvar_version": {
          "minLength": 1,
          "title": "Echtvar Version",
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/ArchiveField"
          },
          "title": "Fields",
          "type": "array"
        },
        "terms": {
          "title": "Terms",
          "type": "string"
        }
      },
      "required": [
        "archive",
        "bytes",
        "sha256",
        "echtvar_version",
        "fields",
        "terms"
      ],
      "title": "NoticedArchiveInfo",
      "type": "object"
    },
    "OmissionReason": {
      "enum": [
        "dated",
        "not_applicable",
        "current",
        "unplaced"
      ],
      "type": "string"
    },
    "OmittedSource": {
      "description": "A source of the downloaded bundle that the run did not name, and why.\n\nThe reason is `dated` for a dated source, which the deployment left out;\n`not_applicable` for one that does not apply to germline small variants; `current` for a current source the run did\nnot name; and `unplaced` for a source docs/annotation.md does not place, which counts as dated.",
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/OmissionReason"
        }
      },
      "required": [
        "source",
        "reason"
      ],
      "title": "OmittedSource",
      "type": "object"
    },
    "PluginMatching": {
      "description": "How the rows of VEP's plugins met the family's `transcripts` rows of one source of transcripts.\n\nVEP reads its own files of the gene models, so a transcript, or a version of one, can be in VEP's file and not\namong the Annotator's, or the other way round, and the two can place a variant differently at the edge of a 5' UTR.\nNeither stops a run.",
      "properties": {
        "source": {
          "$ref": "#/$defs/Source"
        },
        "rows_without_transcript": {
          "title": "Rows Without Transcript",
          "type": "integer"
        },
        "rows_of_other_ids": {
          "title": "Rows Of Other Ids",
          "type": "integer"
        },
        "utr5_transcripts_without_values": {
          "title": "Utr5 Transcripts Without Values",
          "type": "integer"
        }
      },
      "required": [
        "source",
        "rows_without_transcript",
        "rows_of_other_ids",
        "utr5_transcripts_without_values"
      ],
      "title": "PluginMatching",
      "type": "object"
    },
    "PublicFile": {
      "description": "A public file as the preparation read it.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "bytes": {
          "title": "Bytes",
          "type": "integer"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "stated": {
          "items": {
            "type": "string"
          },
          "title": "Stated",
          "type": "array"
        }
      },
      "required": [
        "name",
        "bytes",
        "sha256",
        "stated"
      ],
      "title": "PublicFile",
      "type": "object"
    },
    "Reason": {
      "const": "no informative site",
      "type": "string"
    },
    "RohUpdInfo": {
      "description": "What made a family's roh and upd tables.",
      "properties": {
        "bcftools_version": {
          "minLength": 1,
          "title": "Bcftools Version",
          "type": "string"
        },
        "upd_version": {
          "minLength": 1,
          "title": "Upd Version",
          "type": "string"
        },
        "upd_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Upd Commit",
          "type": "string"
        },
        "preparation": {
          "items": {
            "type": "string"
          },
          "title": "Preparation",
          "type": "array"
        },
        "roh_command": {
          "minLength": 1,
          "title": "Roh Command",
          "type": "string"
        },
        "upd_command": {
          "minLength": 1,
          "title": "Upd Command",
          "type": "string"
        },
        "frequency_archive": {
          "$ref": "#/$defs/FrequencyArchive"
        },
        "sites": {
          "title": "Sites",
          "type": "integer"
        },
        "roh_members": {
          "items": {
            "type": "string"
          },
          "title": "Roh Members",
          "type": "array"
        },
        "upd_children": {
          "items": {
            "$ref": "#/$defs/Trio"
          },
          "title": "Upd Children",
          "type": "array"
        },
        "upd_not_assessed": {
          "items": {
            "$ref": "#/$defs/NotAssessed"
          },
          "title": "Upd Not Assessed",
          "type": "array"
        }
      },
      "required": [
        "bcftools_version",
        "upd_version",
        "upd_commit",
        "preparation",
        "roh_command",
        "upd_command",
        "frequency_archive",
        "sites",
        "roh_members",
        "upd_children",
        "upd_not_assessed"
      ],
      "title": "RohUpdInfo",
      "type": "object"
    },
    "Role": {
      "enum": [
        "proband",
        "father",
        "mother"
      ],
      "type": "string"
    },
    "Sex": {
      "enum": [
        "male",
        "female",
        "unknown"
      ],
      "type": "string"
    },
    "Source": {
      "enum": [
        "Ensembl",
        "RefSeq"
      ],
      "type": "string"
    },
    "SourceVersion": {
      "description": "One version the run config pins: a source, an annotation type and its version.",
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "annotation_type": {
          "title": "Annotation Type",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "source",
        "annotation_type",
        "version"
      ],
      "title": "SourceVersion",
      "type": "object"
    },
    "StrchiveFile": {
      "description": "The STRchive file that a family's repeats were matched with, as the run read it.",
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "bytes": {
          "title": "Bytes",
          "type": "integer"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "release": {
          "title": "Release",
          "type": "string"
        },
        "release_date": {
          "format": "date",
          "title": "Release Date",
          "type": "string"
        },
        "matched_repeats": {
          "title": "Matched Repeats",
          "type": "integer"
        },
        "unmatched_repeats": {
          "title": "Unmatched Repeats",
          "type": "integer"
        }
      },
      "required": [
        "file",
        "bytes",
        "sha256",
        "release",
        "release_date",
        "matched_repeats",
        "unmatched_repeats"
      ],
      "title": "StrchiveFile",
      "type": "object"
    },
    "TableFile": {
      "properties": {
        "table": {
          "title": "Table",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "rows": {
          "title": "Rows",
          "type": "integer"
        },
        "bytes": {
          "title": "Bytes",
          "type": "integer"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "table",
        "path",
        "rows",
        "bytes",
        "sha256"
      ],
      "title": "TableFile",
      "type": "object"
    },
    "Trio": {
      "description": "A child whose parents are both sequenced, by the three samples' names in the family's VCF.",
      "properties": {
        "child": {
          "title": "Child",
          "type": "string"
        },
        "mother": {
          "title": "Mother",
          "type": "string"
        },
        "father": {
          "title": "Father",
          "type": "string"
        }
      },
      "required": [
        "child",
        "mother",
        "father"
      ],
      "title": "Trio",
      "type": "object"
    },
    "VepPlugins": {
      "description": "What the columns of VEP's two plugins come from, and how its rows met the family's.\n\n`run` is the record of the VEP run, which holds nothing of the union's alleles, and `matching` is of this family's\ntables.",
      "properties": {
        "run": {
          "$ref": "#/$defs/VepPluginsInfo"
        },
        "matching": {
          "items": {
            "$ref": "#/$defs/PluginMatching"
          },
          "title": "Matching",
          "type": "array"
        }
      },
      "required": [
        "run",
        "matching"
      ],
      "title": "VepPlugins",
      "type": "object"
    },
    "VepPluginsInfo": {
      "description": "The VEP run that the columns of the two plugins come from (INFO_NAME).",
      "properties": {
        "vep_version": {
          "title": "Vep Version",
          "type": "string"
        },
        "utrannotator_commit": {
          "title": "Utrannotator Commit",
          "type": "string"
        },
        "uorf_evidence": {
          "$ref": "#/$defs/FileRecord"
        },
        "nmd_plugin": {
          "$ref": "#/$defs/FileRecord"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        },
        "environment": {
          "items": {
            "type": "string"
          },
          "title": "Environment",
          "type": "array"
        },
        "gene_models": {
          "items": {
            "$ref": "#/$defs/GeneModelAnnotated"
          },
          "title": "Gene Models",
          "type": "array"
        }
      },
      "required": [
        "vep_version",
        "utrannotator_commit",
        "uorf_evidence",
        "nmd_plugin",
        "options",
        "environment",
        "gene_models"
      ],
      "title": "VepPluginsInfo",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "pipeline_version": {
      "title": "Pipeline Version",
      "type": "string"
    },
    "family": {
      "title": "Family",
      "type": "string"
    },
    "members": {
      "items": {
        "$ref": "#/$defs/FamilyMember"
      },
      "title": "Members",
      "type": "array"
    },
    "tables": {
      "items": {
        "$ref": "#/$defs/TableFile"
      },
      "title": "Tables",
      "type": "array"
    },
    "notes": {
      "$ref": "#/$defs/NotesFile"
    },
    "sv_callers": {
      "items": {
        "$ref": "#/$defs/Caller"
      },
      "title": "Sv Callers",
      "type": "array"
    },
    "alleles": {
      "title": "Alleles",
      "type": "integer"
    },
    "annotation": {
      "$ref": "#/$defs/AnnotationInfo"
    },
    "gnomad_joint": {
      "$ref": "#/$defs/ArchiveInfo"
    },
    "alphagenome_avi": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArchiveInfo"
        },
        {
          "type": "null"
        }
      ]
    },
    "alphagenome_avi_breakdown": {
      "anyOf": [
        {
          "$ref": "#/$defs/NoticedArchiveInfo"
        },
        {
          "type": "null"
        }
      ]
    },
    "alphagenome_splicing": {
      "anyOf": [
        {
          "$ref": "#/$defs/NoticedArchiveInfo"
        },
        {
          "type": "null"
        }
      ]
    },
    "joined_files": {
      "items": {
        "$ref": "#/$defs/JoinedFile"
      },
      "title": "Joined Files",
      "type": "array"
    },
    "vep_plugins": {
      "$ref": "#/$defs/VepPlugins"
    },
    "omitted_columns": {
      "items": {
        "type": "string"
      },
      "title": "Omitted Columns",
      "type": "array"
    },
    "transcripts_omitted_columns": {
      "items": {
        "type": "string"
      },
      "title": "Transcripts Omitted Columns",
      "type": "array"
    },
    "sv_annotation": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnnotationInfo"
        },
        {
          "type": "null"
        }
      ]
    },
    "sv_omitted_columns": {
      "items": {
        "type": "string"
      },
      "title": "Sv Omitted Columns",
      "type": "array"
    },
    "strchive": {
      "anyOf": [
        {
          "$ref": "#/$defs/StrchiveFile"
        },
        {
          "type": "null"
        }
      ]
    },
    "repeats_omitted_columns": {
      "items": {
        "type": "string"
      },
      "title": "Repeats Omitted Columns",
      "type": "array"
    },
    "roh_upd": {
      "$ref": "#/$defs/RohUpdInfo"
    }
  },
  "required": [
    "schema_version",
    "pipeline_version",
    "family",
    "members",
    "tables",
    "notes",
    "sv_callers",
    "alleles",
    "annotation",
    "gnomad_joint",
    "alphagenome_avi",
    "alphagenome_avi_breakdown",
    "alphagenome_splicing",
    "joined_files",
    "vep_plugins",
    "omitted_columns",
    "transcripts_omitted_columns",
    "sv_annotation",
    "sv_omitted_columns",
    "strchive",
