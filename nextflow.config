manifest {
    name = 'case-annotation-pipeline'
    description = "Annotates the variant calls of each family into Parquet tables, with a manifest that describes them"
    nextflowVersion = '!>=26.04.7'
    // The line of pipeline-version.txt, which the workflow reads. It is written out here because Nextflow reads the
    // manifest of a project that it pulls from this file's text, without a projectDir to find another file by.
    version = '0.5.1'
}

// A param, so a launch sets it without a config of its own; without one, outputs go to results/ under the launch
// directory.
outputDir = params.output_dir ?: 'results'

// The release bundled with the oldest supported Nextflow, the one manifest.nextflowVersion names.
plugins {
    id 'nf-google@1.27.4'
}

// Everything here applies however the pipeline is launched. Seqera supplies the executor, project, region, service
// account and work directory itself and selects no profile, so nothing a Seqera run needs may live in a profile; values
// that differ between deployments come in as params.
process {
    // Chosen explicitly: Nextflow's own choice by cpus and memory goes through a deprecated service. E2 is the most
    // widely available family, which matters more than price for these small tasks.
    machineType = 'e2-standard-2'
    // After a failure, tasks already running finish and nothing new starts: one that finishes is reused when the run is
    // resumed after a fix rather than run again.
    errorStrategy = 'finish'
    withLabel: tools {
        container = params.tools_container
    }
    // The Annotator (annotator.nf). Its listings stay on the default machine, a few requests to Illumina's servers each;
    // its download and annotation choose their own (modules/annotator.nf).
    withLabel: illumina {
        container = params.annotator_container
    }
}

google {
    batch {
        // Standard VMs: spot capacity for a machine type can run out in a zone, and a task then waits indefinitely. A
        // Seqera compute environment that sets spot overrides this. Google Batch then starts a reclaimed task again
        // itself, up to its limit of 10 times, so that reclaims do not fail a run; no other failure is retried.
        spot = false
        maxSpotAttempts = 10
        // The Annotator's listings and downloads come from Illumina's servers, so VMs need outbound access.
        usePrivateAddress = false
    }
}

profiles {
    // Launching from a workstation rather than Seqera; the deployment's site config adds project, region, network,
    // service account and work directory.
    google {
        process.executor = 'google-batch'
    }
    // For -stub-run on a small machine such as a CI runner: the local executor rejects a task that asks for more than
    // the machine has.
    stub {
        process.resourceLimits = [cpus: 2, memory: 4.GB]
    }
}
